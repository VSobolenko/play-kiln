<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- S-03/S-11/S-14 use the HTTPS API for photo processing and listing generation. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- S-16's CameraX coach requests access only when the user opens it; the camera is optional. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- S-07 batch-completion notifications are opt-in from Settings (S-17). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- WorkManager uses this for the S-17 Wi-Fi-only upload constraint. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Factory policy: request the fewest permissions possible, never export a component
         without a reason, and never enable cleartext traffic.

         The app does NOT declare android:localeConfig, and this is deliberate. The Language row
         must open an in-app picker (AppCompatDelegate.setApplicationLocales hosted in
         AppCompatActivity), not jump to system settings. Declaring localeConfig would invite a
         second, system-side control for the same value. res/xml/locales_config.xml is kept as the
         picker's language list only — see .cursor/rules/app-settings.mdc. -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PlayKilnSlot">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WorkManager's receiver and service entries are merged from its library manifest;
             they are not app-exported components and are not redeclared here. -->
        <!-- AndroidX per-app language backport: on API 26-32 AppCompat stores the chosen languages
             and re-applies them before the first composition. disabled because the service is a
             metadata holder the library reads, never a component that runs. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- data_out handoff: ExportDelivery shares files from cacheDir/exports through this
             authority. Not exported; access is granted per-share via FLAG_GRANT_READ_URI_PERMISSION.
             The shared scope is limited to cache/exports/ by @xml/file_paths. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
