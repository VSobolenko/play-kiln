<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Looks and settings are the only app data included in cloud backup. -->
    <cloud-backup>
        <include domain="file" path="backup/looks.json" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="datastore/" />
        <exclude domain="file" path="datastore/cutout_queue.preferences_pb" />
        <exclude domain="file" path="datastore/review_prompts.preferences_pb" />
        <!-- Wallet ids, device/session tokens, and cached credit/unlock state are excluded. -->
        <exclude domain="file" path="datastore/wallet.preferences_pb" />
    </cloud-backup>
    <!-- Device transfer adds the local library and Room database to the cloud-backup set. -->
    <device-transfer>
        <include domain="file" path="backup/looks.json" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="datastore/" />
        <exclude domain="file" path="datastore/cutout_queue.preferences_pb" />
        <exclude domain="file" path="datastore/review_prompts.preferences_pb" />
        <include domain="database" path="app.db" />
        <include domain="file" path="sources/" />
        <include domain="file" path="outputs/" />
        <!-- Wallet ids, device/session tokens, and cached credit/unlock state are excluded. -->
        <exclude domain="file" path="datastore/wallet.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
