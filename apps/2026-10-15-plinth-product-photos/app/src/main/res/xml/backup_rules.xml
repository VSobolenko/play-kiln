<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- API 30 and lower has one backup policy, so include only Looks and settings.
         Sources, masks, outputs, scenes, and Room are intentionally absent. -->
    <include domain="file" path="backup/looks.json" />
    <include domain="file" path="datastore/settings.preferences_pb" />
    <include domain="file" path="datastore/" />
    <exclude domain="file" path="datastore/cutout_queue.preferences_pb" />
    <exclude domain="file" path="datastore/review_prompts.preferences_pb" />
    <!-- Wallet identifiers, balance/unlock caches, and tokens must not follow a backup. -->
    <exclude domain="file" path="datastore/wallet.preferences_pb" />
</full-backup-content>
