JWT_SECRET=SET_A_RANDOM_SECRET_LOCALLY
FAL_KEY=
RECOVERY_PEPPER=SET_A_DIFFERENT_RANDOM_SECRET_LOCALLY
DATABASE_PATH=data/server.sqlite
DATA_DIR=data
JOB_CONCURRENCY=2
DAILY_SPEND_CAP_USD=25
STARTER_DAILY_BUDGET_USD=10
STARTER_CREDITS=10
# Local-only Google attestation/recall simulation; startup refuses 1 with NODE_ENV=production.
PLINTH_DEV_INTEGRITY=0
# Maintenance gate: presence pauses NEW paid work; reads, refunds and status stay open.
KILL_SWITCH_FILE=KILL_SWITCH
SERVICE_CLOSED_FILE=SERVICE_CLOSED
# Minimum client version, e.g. 1.4.0. "0" disables the gate. Enforced on every
# mutating route from the version signed into the device token (426 Update Required).
MIN_APP_VERSION=0
# The only trusted reverse-proxy hop; loopback is nginx/Caddy on the same host.
TRUST_PROXY=loopback
# This deployment's own name, reported by /v1/config. The prod/debug separation
# audit (S8c) compares the two public prefixes through it, so they must differ.
PLINTH_ENVIRONMENT=production
PLAY_PACKAGE_NAME=com.gexetr.plinthproductphotos
# Every version code Play may attest, comma-separated — a new release APPENDS its
# code, it never replaces the old one, because a staged rollout serves both and a
# replaced code refuses a valid Play install.
PLAY_VERSION_CODES=
# Legacy single value; ignored when PLAY_VERSION_CODES is set.
PLAY_VERSION_CODE=
# "1" grants the 10 starter credits when Play's verdicts pass but Device Recall
# returned no value (it must be enabled in Play Console for reinstall resistance).
STARTER_ALLOW_WITHOUT_RECALL=0
PLAY_SIGNING_CERT_SHA256=
PLAY_SERVICE_ACCOUNT_JSON=
BILLING_BINDING_SECRET=
PURCHASE_TOKEN_KEK=
PLAY_CREDIT_PRODUCTS={}
# One-time non-consumable entitlements: product id -> "unlock" (the only accepted name), e.g. {"plinth_unlock":"unlock"}
PLAY_ENTITLEMENT_PRODUCTS={}
PUBSUB_AUDIENCE=
PUBSUB_SERVICE_ACCOUNT_EMAIL=
