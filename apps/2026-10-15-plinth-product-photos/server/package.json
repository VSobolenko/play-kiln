{
  "name": "plinth-product-photos-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "build": "tsc && node scripts/copy-migrations.mjs",
    "backup": "node scripts/backup-db.mjs",
    "drill:restore": "node scripts/restore-drill.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/jwt": "^9.1.0",
    "ajv": "^8.17.1",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.6.0",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
