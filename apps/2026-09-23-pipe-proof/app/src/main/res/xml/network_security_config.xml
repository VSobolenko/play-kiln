<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Factory apps ship HTTPS-only. Add narrowly scoped trust rules only when required. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
