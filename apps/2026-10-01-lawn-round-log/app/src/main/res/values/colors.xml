<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Seed/brand colors are used only by the launcher artwork and the pre-Compose window
         background. Runtime UI colors always come from MaterialTheme.colorScheme. -->
    <color name="playkiln_seed">#006C4C</color>
    <color name="playkiln_seed_dark">#63DBA6</color>

    <!-- Window background shown for the few milliseconds before Compose draws its first frame.
         It is the light scheme's own `background`, Chalk in ui/theme/Color.kt, so the pre-Compose
         frame cannot flash a colour the app never draws. Keep it equal to that constant. -->
    <color name="playkiln_window_background">#F6F4E4</color>
</resources>
