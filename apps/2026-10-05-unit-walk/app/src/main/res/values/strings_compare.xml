    <string name="compare_kind_single" translatable="true">Single walk</string>
    <string name="compare_no_prior_short" translatable="true">No prior report</string>
    <string name="compare_no_prior_notice" translatable="true">There is no prior move-in report for this unit, so only the current walk is shown. No baseline has been invented.</string>
    <string name="compare_column_prior" translatable="true">Move-in</string>
    <string name="compare_column_current" translatable="true">Move-out</string>
    <string name="compare_condition_good" translatable="true">Good</string>
