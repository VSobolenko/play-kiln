<?xml version="1.0" encoding="utf-8"?>
<!--
  Move-in versus move-out comparison. Owned by the compare screen worker; the keys are
  scope-prefixed `compare_*` and are mirrored key-for-key in values-ru/strings_compare.xml.

  `compare_no_prior_notice` and `compare_no_prior_short` are the words the screen uses when the
  ViewModel reports `CompareOutcome.NoPriorReport`: the surface says "no prior report" plainly and
  never draws a baseline that was not recorded.
-->
