<?xml version="1.0" encoding="utf-8"?>
<!--
    Copy for the room-by-room walk screen, owned by the walk worker.

    Keys are `walk_*` and are mirrored in values-ru/strings_walk.xml with real Russian.
    Every label, hint, status and message the walk screen renders lives here, so no
    user-facing prose is compiled into Kotlin (locale.hardcoded) and every key has a
    translation in both declared languages (locale.multilingual / slot.locales).
-->
