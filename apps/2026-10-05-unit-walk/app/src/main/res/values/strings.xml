<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name" translatable="true">UnitWalk</string>
    <string name="app_idea" translatable="true">UnitWalk — a crash-safe, no-account rental unit walk for self-managing landlords: room-by-room photo condition records that survive a process kill, move-in versus move-out compare per unit, and a signed PDF shared from the phone.</string>
    <string name="about_title" translatable="true">About this app</string>
    <string name="about_back" translatable="true">Back</string>
    <string name="about_body" translatable="true">%1$s keeps the condition record of every rental unit on this phone: a photo and a note per room, written as the walk goes on, so an inspection that finished is an inspection that survived. No account, no upload, no server.</string>
    <string name="about_privacy_note" translatable="true">Your units, walks, photos and notes stay in this app on the device; nothing is sent anywhere. The privacy policy below is the complete description of what the app does with your data.</string>
    <string name="about_privacy_action" translatable="true">Open the privacy policy</string>
    <!-- The policy address is data, not prose: `translatable="false"` keeps it out of the translation
         round-trip (and out of `values-ru/`, where a second copy could only drift), and Play requires
         the policy to be reachable from inside the app as well as from the listing
         (store/listing.json). AboutScreen opens it through LocalUriHandler. -->
    <string name="about_privacy_url" translatable="false">https://telegra.ph/UnitWalk--privacy-policy-10-05</string>

