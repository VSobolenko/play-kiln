<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The dark configuration of `values/colors.xml`. `DayNight` on the activity theme resolves it
      itself, so there is no `values-night/themes.xml` — a second activity theme in this
      configuration would be a non-AppCompat parent and would crash an `AppCompatActivity` in dark
      mode.

      `playkiln_window_background` is the dark scheme's own `background` role (`Color.kt`'s
      `BackgroundDark`), so the window and the theme paint the same colour and a dark-mode launch
      never flashes the light field. `scripts/core/uiux.mjs`'s `uiux.content-colour` reads this value
      from the XML here and measures the contrast a default content colour would have on it, which is
      the defect it was written for: black glyphs on a dark window are invisible.
    -->
    <color name="playkiln_window_background">#111A23</color>

    <!-- The palette's dark steps, for any XML consumer. -->
    <color name="unitwalk_paper">#F7F9FB</color>
    <color name="unitwalk_ink">#0E1A24</color>
    <color name="unitwalk_ink_soft">#16283A</color>
    <color name="unitwalk_ink_lift">#24425E</color>
    <color name="unitwalk_amber">#E8A93C</color>
    <color name="unitwalk_amber_deep">#C87A1E</color>
    <color name="unitwalk_amber_pale">#F2D3A0</color>
    <color name="unitwalk_accent_deep">#2E6E80</color>
    <color name="unitwalk_muted">#A7B4C2</color>
    <color name="unitwalk_bezel">#14100C</color>
    <color name="unitwalk_bezel_rim">#8D8174</color>

    <!-- Seeds are the same in both configurations: the launcher artwork is rendered once, from the
         palette, and is not re-tinted by the system configuration. -->
    <color name="unitwalk_seed">#2E6E80</color>
    <color name="unitwalk_seed_dark">#E8A93C</color>
</resources>
