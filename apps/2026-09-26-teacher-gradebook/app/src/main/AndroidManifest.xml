<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Factory policy: request the fewest permissions possible, never export a component
         without a reason, and never enable cleartext traffic.

         This app declares no permission of its own, and the merged manifest was read rather than
         assumed. It contains exactly four entries, and two of them are not ours:
           com.android.vending.BILLING    normal; required by the Play Billing library
           ...DYNAMIC_RECEIVER_...        normal; added by AndroidX, not requestable by apps
           android.permission.INTERNET           } pulled in by
           android.permission.ACCESS_NETWORK_STATE } com.google.android.datatransport, a
         transitive dependency of Play Billing. The app's own code contains no HTTP client and no
         URL, and network_security_config.xml forbids cleartext, so nothing of the teacher's is
         sent by this app. Those two permissions exist for Google's purchase traffic, and
         store/privacy.md and store/data-safety.md disclose them as such instead of claiming the
         app has no internet access. The observed list is recorded in store/checklist.md. -->
    <application
        android:name=".PlayKilnApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PlayKilnSlot">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
