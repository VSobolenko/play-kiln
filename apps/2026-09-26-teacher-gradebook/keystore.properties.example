# Never commit the real keystore.properties file or any upload-key credentials.
# The real keystore.properties file is gitignored.
#
# Create a Play App Signing upload key from this directory with:
# keytool -genkeypair -v -keystore upload.jks -alias upload -keyalg RSA -keysize 4096 -validity 10000
#
# Play App Signing keeps the real app-signing key at Google. If the upload key is
# lost or compromised, request an upload-key reset through Play Console.

# storeFile=../upload.jks
# storePassword=
# keyAlias=upload
# keyPassword=
