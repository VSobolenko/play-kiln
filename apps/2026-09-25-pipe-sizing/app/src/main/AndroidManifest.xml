<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Factory policy: request the fewest permissions possible, never export a component
         without a reason, and never enable cleartext traffic. -->

    <!-- Ad and billing capability manifests declare the advertising ID permission; the network
         permission the Ads and Play Billing SDKs require is declared here so the dependency is
         visible in the slot's own manifest rather than only in a merged one. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".PlayKilnApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PlayKilnSlot">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The Mobile Ads SDK reads its application ID from manifest metadata, not from code.
             The value is a manifest placeholder so a release supplies the real AdMob app ID as a
             Gradle property while a debug build keeps Google's public test ID and serves no live
             inventory. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobApplicationId}" />
    </application>

</manifest>
