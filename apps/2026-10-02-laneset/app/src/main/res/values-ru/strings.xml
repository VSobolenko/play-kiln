<?xml version="1.0" encoding="utf-8"?>
<!--
  Laneset's Russian words, key for key with values/strings.xml.

  Android merges every file in values/ into one resource table, and scripts/core/policy.mjs compares
  the two trees in both directions: a key here with no default, a default with no key here, or a
  format argument in a different position is a failure rather than a silent fallback to English. The
  file therefore mirrors the English tree exactly — the same preserved keys, the same home keys, the
  same placeholders in the same order — and only the sentences differ.

  The Russian is written rather than machine-translated, and the words are the ones a Russian pool
  uses: вольный стиль, брасс, лопатки, колобашка, заминка. A stroke or a piece of gear stays lower
  case because it is read mid-sentence in a set line, exactly as in the English tree.
-->
<resources>

    <!-- The app's identity. The carrier is a brand and stays Latin; the idea line is the app's
         own sentence and this screen does not rewrite it. -->
    <string name="app_name" translatable="true">Laneset: Swim Set Builder</string>
    <string name="app_idea" translatable="true">A swim set builder that computes each session from the swimmer\'s own constraints (minutes, pool length, focus, strokes to avoid, gear on deck) against authored programming rules, walks them through the two pace trials that put a target time on every interval, and prints or shares the set list; one-time unlock, offline, no account.</string>

    <!-- Read by ui/PlayKilnApp.kt for the empty detail pane beside Home. -->
    <string name="home_pick_section" translatable="true">Выберите раздел, чтобы открыть его здесь.</string>

