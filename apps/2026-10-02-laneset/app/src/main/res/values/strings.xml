    <string name="home_block_headline" translatable="true">%1$d × %2$d m</string>
    <string name="home_pace_value_default" translatable="true">Targets use the app\'s default pace of %1$s /100 m. The two trials replace it with your own.</string>
    <string name="home_pace_value_yours" translatable="true">Targets use your own measured pace.</string>
    <string name="home_trials_action" translatable="true">Swim the 400 m and 200 m trials</string>
    <string name="home_trials_locked_action" translatable="true">Unlock the guided pace test</string>
    <string name="home_stat_distance" translatable="true">Distance</string>
    <string name="home_stat_time" translatable="true">Time</string>
    <string name="home_stat_intervals" translatable="true">Intervals</string>
    <string name="home_stat_pace" translatable="true">Pace /100 m</string>
    <!-- The unit formatters: a pool length and a minute budget are read as one value with its unit,
