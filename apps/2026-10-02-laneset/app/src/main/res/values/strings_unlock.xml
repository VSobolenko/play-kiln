<?xml version="1.0" encoding="utf-8"?>
<!--
  The single-price unlock surface.

  Every string here is referenced by `ui/unlock/UnlockScreen.kt`. The two facts this surface exists to
  state plainly are that the unlock is ONE payment and that there is NO subscription: the shelf's
  leader sells the useful half as a recurring plan, so saying so is the pitch rather than a footnote.
  No numeric price appears here on purpose — Google Play shows the localized price on its own
  confirmation sheet, and a hard-coded currency is wrong everywhere outside the dollar zone.
-->
<resources>
    <string name="unlock_title" translatable="true">Unlock</string>
    <string name="unlock_back" translatable="true">Back</string>

    <string name="unlock_hero_label" translatable="true">One payment, not a subscription</string>
    <string name="unlock_lede" translatable="true">Laneset is free to use. One payment opens the rest of the app, and it stays yours.</string>

    <string name="unlock_includes_header" translatable="true">The unlock gives you</string>
    <string name="unlock_benefit_focuses" translatable="true">Every other focus: Sprint, Threshold, Technique and Recovery</string>
    <string name="unlock_benefit_pace_test" translatable="true">The guided 400 m and 200 m pace test</string>
    <string name="unlock_benefit_import" translatable="true">Coach-workout import</string>
    <string name="unlock_benefit_handoff" translatable="true">Share and print a finished set</string>

    <string name="unlock_purchase_label" translatable="true">Purchase</string>
    <string name="unlock_purchase_value" translatable="true">One-time</string>
    <string name="unlock_subscription_label" translatable="true">Subscription</string>
    <string name="unlock_subscription_value" translatable="true">None</string>
    <string name="unlock_no_renewal" translatable="true">No subscription, no trial and no renewal. You pay once and keep the unlock.</string>
    <string name="unlock_price_note" translatable="true">Google Play shows the exact price in your currency on its confirmation sheet before you pay.</string>

    <string name="unlock_buy" translatable="true">Unlock the full app</string>
    <string name="unlock_purchasing" translatable="true">Opening Google Play…</string>
    <string name="unlock_action_restore" translatable="true">Restore a purchase</string>
    <string name="unlock_action_retry" translatable="true">Try again</string>

