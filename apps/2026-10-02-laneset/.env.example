# Copy to .env and fill locally. Never commit .env.

# Path to upload keystore (outside git preferred)
# KEYSTORE_PATH=
# KEYSTORE_PASSWORD=
# KEY_ALIAS=
# KEY_PASSWORD=

# Optional Firebase / other APIs for this slot only
# FIREBASE_PROJECT_ID=

# The one code out of the slot's `promo-codes.csv` batch that is pasted into Play Console ->
# App content -> App access -> the credentials dialog. Recorded here so the live declaration
# can be traced back to the batch it came from, and so the reviewer instruction can be
# rebuilt without digging the code out of the console.
# REVIEWER_PROMO_CODE=
